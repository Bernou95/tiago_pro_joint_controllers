<?xml version="1.0"?>
<launch>
  <!-- Launch the PositionJointController on the REAL TiagoPro robot.
       Re-uses tiago_pro_bringup for all standard infrastructure and spawns
       position_joint_controller via --param-file so the controller type is
       registered with the controller_manager dynamically.

       Usage:
         ros2 launch position_joint_controller position_joint_controller.launch.xml robot_ip:=<IP>
  -->

  <arg name="robot_ip"         description="IP address of the TiagoPro robot"/>
  <arg name="robot_type"       default="tiago_pro"   description="Robot model (tiago_pro, ...)"/>
  <arg name="arm_prefix"       default=""            description="Prefix for multi-arm setups"/>
  <arg name="load_gripper"     default="false"       description="Load TiagoPro gripper"/>
  <arg name="use_fake_hardware" default="false"      description="Use fake hardware instead of real robot"/>

  <include file="$(find-pkg-share tiago_pro_bringup)/launch/tiago_pro.launch.py">
    <arg name="robot_ip"          value="$(var robot_ip)"/>
    <arg name="robot_type"        value="$(var robot_type)"/>
    <arg name="arm_prefix"        value="$(var arm_prefix)"/>
    <arg name="load_gripper"      value="$(var load_gripper)"/>
    <arg name="use_fake_hardware" value="$(var use_fake_hardware)"/>
  </include>

  <node pkg="controller_manager" exec="spawner" name="spawner_position_joint_controller"
        args="position_joint_controller
              --controller-manager-timeout 30
              --param-file $(find-pkg-share position_joint_controller)/config/controllers.yaml"
        output="screen"/>
</launch>
