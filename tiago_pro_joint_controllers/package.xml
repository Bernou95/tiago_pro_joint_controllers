<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tiago_pro_joint_controllers</name>
  <version>0.1.0</version>
  <description>
    Meta-package that groups all TiagoPro joint controllers:
    effort_joint_controller, position_joint_controller, and velocity_joint_controller.
  </description>
  <maintainer email="user@example.com">User</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>tiago_pro_joint_controllers_msgs</exec_depend>
  <exec_depend>motion_controller_interface</exec_depend>
  <exec_depend>effort_joint_controller</exec_depend>
  <exec_depend>position_joint_controller</exec_depend>
  <exec_depend>velocity_joint_controller</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
